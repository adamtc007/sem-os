[net]
git-fetch-with-cli = true

# Local-dev patch: redirect the dsl git dep to the sibling repo on disk.
#
# Usage: cp .cargo/config.toml.example .cargo/config.toml  (gitignore keeps it local)
# Revert: delete .cargo/config.toml to test against real GitHub tags.
[patch."https://github.com/adamtc007/dsl"]
dsl_types = { path = "../dsl/crates/dsl_types" }
dsl-core  = { path = "../dsl/crates/dsl-core"  }
